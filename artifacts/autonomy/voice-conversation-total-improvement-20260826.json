          "operator": ">",
          "value": 300
        },
        {
          "metric": "unexpectedTranscriptCount",
          "operator": ">",
          "value": 0
        },
        {
          "metric": "emptyAudioCount",
          "operator": ">",
          "value": 0
        }
      ]
    }
