+/* The 0.6B CLI applies emotion by shifting a cloned speaker x-vector along a
+ * shipped, speaker-independent direction. The HTTP path used to call only
+ * qwen_tts_apply_emotion(), whose 0.6B behavior is intentionally a no-op.
+ *
+ * Never mutate the loaded/shared embedding in-place: worker contexts shallow-
+ * copy it from the base context. Instead install a request-owned transformed
+ * copy and restore the original pointer after synthesis. This is safe for
+ * concurrent workers and prevents emotion state leaking to the next request. */
+typedef struct {
+    float *original;
+    float *owned;
+} request_speaker_embedding_t;
+
+static void restore_request_speaker_embedding(qwen_tts_ctx_t *ctx,
+                                               request_speaker_embedding_t *guard) {
+    if (!guard || !guard->owned) return;
+    ctx->speaker_embedding = guard->original;
+    free(guard->owned);
+    guard->original = NULL;
+    guard->owned = NULL;
+}
+
+static int apply_06b_emotion_direction(qwen_tts_ctx_t *ctx, const char *emotion_spec,
+                                       float strength,
+                                       request_speaker_embedding_t *guard) {
+    if (!emotion_spec || !emotion_spec[0] || ctx->config.hidden_size >= 2048) return 0;
+    if (!ctx->voice_clone || !ctx->speaker_embedding || !guard) {
+        fprintf(stderr, "Error: 0.6B HTTP emotion requires a loaded cloned voice x-vector\n");
+        return -1;
+    }
+
+    const char *tok = qwen_emotion_name_to_tok(emotion_spec);
+    if (!tok) {
+        fprintf(stderr, "Error: '%s' is not a known emotion\n", emotion_spec);
+        return -1;
+    }
+
+    char path[512];
+    snprintf(path, sizeof(path), "presets/emovoice/dir_%s.bin", tok);
+    FILE *fp = fopen(path, "rb");
+    if (!fp) {
+        fprintf(stderr, "Error: missing 0.6B emotion direction '%s'\n", path);
+        return -1;
+    }
+
+    int h = ctx->speaker_enc.enc_dim > 0 ? ctx->speaker_enc.enc_dim : ctx->config.hidden_size;
+    float *direction = (float *)malloc((size_t)h * sizeof(float));
+    float *shifted = (float *)malloc((size_t)h * sizeof(float));
+    if (!direction || !shifted || fread(direction, sizeof(float), (size_t)h, fp) != (size_t)h) {
+        fprintf(stderr, "Error: could not read 0.6B emotion direction '%s' (%d floats expected)\n", path, h);
+        free(direction); free(shifted); fclose(fp);
+        return -1;
+    }
+    fclose(fp);
+    memcpy(shifted, ctx->speaker_embedding, (size_t)h * sizeof(float));
+
+    float n0 = 0.0f;
+    for (int i = 0; i < h; i++) n0 += shifted[i] * shifted[i];
+    n0 = sqrtf(n0);
+    for (int i = 0; i < h; i++) shifted[i] += strength * n0 * direction[i];
+    float n1 = 0.0f;
+    for (int i = 0; i < h; i++) n1 += shifted[i] * shifted[i];
+    n1 = sqrtf(n1);
+    if (n1 > 1e-6f) for (int i = 0; i < h; i++) shifted[i] *= n0 / n1;
+    free(direction);
+
+    guard->original = ctx->speaker_embedding;
+    guard->owned = shifted;
+    ctx->speaker_embedding = shifted;
+    fprintf(stderr, "Emotion '%s' on 0.6B HTTP: generic direction @ %.2f\n", tok, (double)strength);
+    return 0;
+}
