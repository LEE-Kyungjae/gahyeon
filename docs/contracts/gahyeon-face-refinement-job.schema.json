{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gahyeon.local/schemas/gahyeon-face-refinement-job.schema.json",
  "title": "Gahyeon Face Refinement Job",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "detector", "generation", "outputs"],
  "properties": {
    "schemaVersion": {"const": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "detector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "confidence", "bbox"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "bbox": {
          "type": "array",
          "prefixItems": [
            {"type": "integer", "minimum": 0},
            {"type": "integer", "minimum": 0},
            {"type": "integer", "minimum": 1},
            {"type": "integer", "minimum": 1}
          ],
          "items": false
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint", "checkpointSha256", "lora", "loraSha256", "loraStrength", "seed", "denoise", "prompt", "negativePrompt"],
      "properties": {
        "checkpoint": {"type": "string", "minLength": 1},
        "checkpointSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "lora": {"type": "string", "minLength": 1},
        "loraSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "loraStrength": {"type": "number", "minimum": 0, "maximum": 2},
        "seed": {"type": "integer", "minimum": 0},
        "denoise": {"type": "number", "minimum": 0, "maximum": 1},
        "prompt": {"type": "string", "minLength": 1},
        "negativePrompt": {"type": "string"}
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original", "refined", "comparison"],
      "properties": {
        "original": {"type": "string", "minLength": 1},
        "refined": {"type": "string", "minLength": 1},
        "comparison": {"type": "string", "minLength": 1}
      }
    }
  }
}
